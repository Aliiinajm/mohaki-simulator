# ============================================================
#  محاكي نبض — ملف متغيرات البيئة
#  انسخ هذا الملف إلى ‎.env ثم عدّل القيم:
#     copy .env.example .env      (Windows CMD)
#     Copy-Item .env.example .env (PowerShell)
#     cp .env.example .env        (macOS / Linux)
# ============================================================

# ------------------------------------------------------------
# (1) قاعدة البيانات — إلزامية للتخزين المؤقت فقط
# ------------------------------------------------------------
# التطبيق يعمل بدونها (البحث الكيميائي يذهب مباشرة إلى PubChem/CACTUS)،
# لكن الذاكرة المؤقتة وإحصائيات "المركبات المحفوظة" وحفظ تحليلات
# الخريطة ستكون معطلة، وستظهر رسالة في سجل الخادم.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# صيغة الرابط:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#  USER      اسم المستخدم (افتراضي Postgres: postgres)
#  PASSWORD  كلمة المرور
#  HOST      127.0.0.1 للتشغيل المحلي
#  PORT      5432 افتراضياً
#  DATABASE  اسم قاعدة البيانات (يجب أن تكون موجودة مسبقاً)
#
# مثال إنشاء القاعدة محلياً:
#   psql -U postgres -c "CREATE DATABASE app_db;"
#
# بعد ضبط الرابط أنشئ الجداول (مرة واحدة):
#   npx drizzle-kit push
#
# لاختبار الاتصال والتشخيص افتح في المتصفح:
#   http://localhost:8080/api/health
# سيعرض حالة الاتصال وعدد الجداول وسبب أي فشل.
#
# ملاحظة: drizzle.config.json يحتوي على رابط منفصل خاص بأوامر
# drizzle-kit. إذا غيّرت DATABASE_URL هنا فعدّل الرابط هناك أيضاً،
# أو مرّره مباشرة:
#   npx drizzle-kit push --url "%DATABASE_URL%"

# ------------------------------------------------------------
# (2) مفاتيح اختيارية — التطبيق يعمل بدونها بالكامل
# ------------------------------------------------------------
# إن تُركت فارغة أو حُذفت، يتخطى الخادم الخدمة المقابلة ويعلّمها
# بأنها "skipped" في بطاقة المركب، ولا يتعطل أي مسار.

# ChemSpider (Royal Society of Chemistry Compounds API)
# مفتاح مجاني: https://developer.rsc.org
CHEMSPIDER_API_KEY=

# IBM RXN for Chemistry — تنبؤ بنواتج التفاعلات العضوية المعقدة
# مفتاح مجاني: https://rxn.app.accelerate.science
IBM_RXN_API_KEY=
# اتركه فارغاً ليُنشأ مشروع تلقائياً عند أول استخدام
IBM_RXN_PROJECT_ID=
IBM_RXN_BASE_URL=https://rxn.app.accelerate.science
